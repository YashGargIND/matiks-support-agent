# Secrets stay on this machine. Never commit the populated .env.
SEND_MODE=dry_run
ACTION_MODE=dry_run
SLACK_POST_MODE=dry_run
OPENAI_AGENTS_DISABLE_TRACING=1
OPENROUTER_API_KEY=
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901611930428
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=7
# Google OAuth is supported instead of IMAP_APP_PASSWORD. Access tokens stay in memory.
# IMAP requires the existing https://mail.google.com/ grant; it uses EXAMINE/BODY.PEEK only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
IMAP_REFRESH_TOKEN=
# Only enable model calls after reviewing redacted inputs in the console.
LLM_ENABLED=false
SUPPORT_DB=data/support.sqlite3
# Optional read-only integrations. No collection names are assumed.
MONGO_URI_READONLY=
MONGO_DATABASE=
# Set explicitly, including when payments share MONGO_DATABASE.
PAYMENTS_MONGO_DATABASE=
# Run inspect-schema and confirm current BSON fields before setting true.
MONGO_SCHEMA_VERIFIED=false
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
MODERATION_API_URL=
MODERATION_API_KEY=
# Existing @admin GraphQL conversation read. The adapter only executes one fixed query.
MATIKS_GRAPHQL_URL=
MATIKS_ADMIN_READ_TOKEN=
# Local bounded code/commit/CODEOWNERS reads only; no repository edits.
REPO_PATH=
SLACK_BOT_TOKEN=
